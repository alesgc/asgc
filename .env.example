# ============================================================
#  .env.example — Variáveis de Ambiente do Portfólio ASGC v1.1.0
# ------------------------------------------------------------
#  Copie este arquivo para ".env.local" (NÃO commitado) e preencha
#  os placeholders abaixo. NUNCA comite valores reais de API keys
#  no repositório. Use apenas placeholders do tipo "re_sua_chave_aqui".
# ============================================================

# ------------------------------------------------------------
#  CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ------------------------------------------------------------

# Ambiente runtime do Next.js. Valores aceitos: development | production.
#   - Local:  mantenha "development"
#   - Vercel Production / Preview: definido automaticamente pela Vercel (não precisa preencher)
NEXT_PUBLIC_APP_ENV=development

# URL pública do site (NEXT_PUBLIC_* fica visível no browser).
# Utilizado para:
#   - Canonical URLs e metadados SEO em sitemap.ts + robots.ts
#   - Links absolutos em e-mails do Resend
#   - Deep-links WhatsApp / mailto com referência
# Exemplos:
#   Produção ...................: https://asgc.vercel.app
#   Local / Preview temporário .: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
#  PROVEDOR DE E-MAIL — RESEND (https://resend.com)
#  Utilizado na rota /api/contact para envio do formulário LGPD.
# ------------------------------------------------------------

# Chave da API Resend. Crie em https://resend.com/api-keys.
# Escopo recomendado: "Sending" (apenas envio, sem acesso a audience/chaves extras).
# Valor esperado prefixo: `re_` (ex.: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx).
# NÃO deixe a chave vazia ao testar o formulário /contact → API retorna 500.
RESEND_API_KEY=re_sua_chave_aqui

# Destinatário final dos e-mails de contato.
# Este valor NÃO aparece no frontend; é lido apenas no Route Handler server-side.
# Padrão homologado Alexandre S. G. Camargo: asgc.devolp@gmail.com
CONTACT_RECIPIENT_EMAIL=asgc.devolp@gmail.com

# ------------------------------------------------------------
#  INTEGRAÇÃO COM A API REST DO GITHUB
#  Utilizada para listar dinamicamente projetos no filter #projetos.
#  OBRIGATORIO: repositórios filtrados pelo topico "portfolio".
# ------------------------------------------------------------

# Token Fine-Grained do GitHub (recomendado ao invés de Classic).
# Crie em: https://github.com/settings/tokens → "Generate new token (Fine-grained)".
#   - Repository access: "Public Repositories (read-only)" BASTA.
#   - Permissions: Metadata (padrão) + Contents:Read se quiser parser README PORTFOLIO:*
#   - Expiração: configure 90 dias e renove.
# Prefixo esperado: `github_pat_` (fine-grained) OU `ghp_` (classic legado).
# Funcionamento fallback: se vazio, site usa app/config/projects.ts hardcoded.
GITHUB_TOKEN=ghp_seu_personal_access_token_aqui
